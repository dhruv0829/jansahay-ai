# Copy this template to backend/.env. Never put real secrets in this file.
# Local SQLite mode:
DATABASE_URL=sqlite:///./jansahay.db
# Supabase PostgreSQL (copy the exact Session Pooler host/user from Supabase Connect):
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Generate a unique value for local use.
SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
ENABLE_DEMO_ACCOUNTS=true
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM API key. Keep the real value only in backend/.env.
GROQ_API_KEY=

PORT=8000
HOST=0.0.0.0
